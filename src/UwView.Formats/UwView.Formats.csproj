<Project Sdk="Microsoft.NET.Sdk">
  <!-- UwView.Core（無料版の公開部品）から、圧縮の展開と Word・Excel・PDF の文字の取り出しに要るファイルだけを写したもの。
       ファイルは変えない（写し直しは tools/sync_uwview.sh。元の commit は UPSTREAM.md）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>UwView.Core</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
