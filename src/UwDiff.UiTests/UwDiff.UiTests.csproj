<Project Sdk="Microsoft.NET.Sdk">
  <!--
    画面の試験（UwView と同じ方式: Avalonia Headless で本物の窓を組み立て、描画は Skia で本当に描く）。
    写しは UVD_SHOTS（無ければ一時フォルダの uvd-shots）に PNG で残す。
      dotnet test src/UwDiff.UiTests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UwDiff.App\UwDiff.App.csproj" />
  </ItemGroup>
</Project>
